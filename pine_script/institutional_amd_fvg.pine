//@version=5
indicator("Institutional A-M-D & Dynamic Accumulation Engine [Pro]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUT SETTINGS & CONTESTO MTF
// ==============================================================================
grp_mtf       = "Contesto e Key Level MTF (H4 / H1)"
show_mtf_kl   = input.bool(true, "Mostra Key Levels MTF (IMB / Rejection)", group=grp_mtf)
mtf_tf        = input.timeframe("60", "Timeframe MTF Principale (60=H1, 240=H4)", group=grp_mtf)
col_kl_bear   = input.color(color.new(color.maroon, 85), "Colore Key Level Bearish (Premium)", group=grp_mtf)
col_kl_bull   = input.color(color.new(color.teal, 85), "Colore Key Level Bullish (Discount)", group=grp_mtf)

grp_accum     = "Accumulazione Orizzontale (Box) & Dinamica (Swing M/m)"
show_box      = input.bool(true, "Disegna Box Accumulazione Orizzontale", group=grp_accum)
box_len       = input.int(10, "Barre Box Orizzontale", minval=6, maxval=20, group=grp_accum)
min_imb_pips  = input.float(1.0, "Minimo IMB di Rottura (Pips)", minval=0.3, step=0.1, group=grp_accum)

grp_levels    = "Livelli Operativi (Rientro in IMB, SL e Target MTF)"
show_levels   = input.bool(true, "Mostra Entry su Rientro IMB, SL e Target MTF", group=grp_levels)

// ==============================================================================
// 2. VALIDAZIONE KEY LEVEL MTF & FILTRO PREMIUM / DISCOUNT (50%)
// ==============================================================================
pip_val = syminfo.mintick * 10
[mtf_h, mtf_l, mtf_c, mtf_o, mtf_h2, mtf_l2] = request.security(syminfo.tickerid, mtf_tf, [high, low, close, open, high[2], low[2]])

mtf_range_high = ta.highest(mtf_h, 24)
mtf_range_low  = ta.lowest(mtf_l, 24)
mtf_eq_50      = (mtf_range_high + mtf_range_low) / 2.0

is_premium  = close > mtf_eq_50
is_discount = close < mtf_eq_50

// Rilevamento Key Level MTF
new_mtf_bar  = ta.change(time(mtf_tf)) != 0
mtf_bear_imb = new_mtf_bar and (mtf_l2 - mtf_h) >= (1.5 * pip_val) and mtf_l2 >= mtf_eq_50
mtf_bull_imb = new_mtf_bar and (mtf_l - mtf_h2) >= (1.5 * pip_val) and mtf_h2 <= mtf_eq_50

var float active_bear_kl_top = na
var float active_bear_kl_bot = na
var float active_bull_kl_top = na
var float active_bull_kl_bot = na

if mtf_bear_imb
    active_bear_kl_top := mtf_l2
    active_bear_kl_bot := mtf_h
    if show_mtf_kl
        box.new(bar_index - 4, active_bear_kl_top, bar_index + 20, active_bear_kl_bot,
                bgcolor=col_kl_bear, border_color=color.new(color.maroon, 40),
                text="KL MTF Bearish", text_size=size.tiny, text_color=color.white)

if mtf_bull_imb
    active_bull_kl_top := mtf_l
    active_bull_kl_bot := mtf_h2
    if show_mtf_kl
        box.new(bar_index - 4, active_bull_kl_top, bar_index + 20, active_bull_kl_bot,
                bgcolor=col_kl_bull, border_color=color.new(color.teal, 40),
                text="KL MTF Bullish", text_size=size.tiny, text_color=color.white)

// Regola Fonte 16: Invalidazione del Key Level se >= 2 chiusure di corpo oltre il KL
if not na(active_bear_kl_top) and close > active_bear_kl_top and close[1] > active_bear_kl_top
    active_bear_kl_top := na
    active_bear_kl_bot := na

if not na(active_bull_kl_bot) and close < active_bull_kl_bot and close[1] < active_bull_kl_bot
    active_bull_kl_top := na
    active_bull_kl_bot := na

// ==============================================================================
// 3. RILEVAMENTO ACCUMULAZIONE (BOX ORIZZONTALE O SWING DINAMICO M/m)
// ==============================================================================
box_M = ta.highest(high[1], box_len)
box_m = ta.lowest(low[1], box_len)
is_horiz_box = (box_M - box_m) <= (10.0 * pip_val)

// Ultimo Swing Dinamico M / m
ph_M = ta.pivothigh(high, 3, 2)
pl_m = ta.pivotlow(low, 3, 2)

var float dyn_M = na
var float dyn_m = na
if not na(ph_M)
    dyn_M := ph_M
if not na(pl_m)
    dyn_m := pl_m

// Livello M / m attivo e morfologia
float ref_m_short = is_horiz_box ? box_m : dyn_m
float ref_M_long  = is_horiz_box ? box_M : dyn_M
string accum_mode = is_horiz_box ? "AMD_HORIZONTAL_BOX" : "DYNAMIC_ACCUMULATION_BOS"

// ==============================================================================
// 4. ROTTURA DI M/m CON IMB + ALMENO 2 CHIUSURE OLTRE + RIENTRO NELL'IMB
// ==============================================================================
imb_gap_min = min_imb_pips * pip_val
bear_fvg    = (low[2] - high) >= imb_gap_min
bull_fvg    = (low - high[2]) >= imb_gap_min

// Stato del setup Short e Long
var float pending_sell_imb_top = na
var float pending_sell_imb_bot = na
var float pending_sell_sl      = na
var float pending_sell_m       = na
var string pending_sell_mode   = ""
var int sell_closes_below_m    = 0

var float pending_buy_imb_top  = na
var float pending_buy_imb_bot  = na
var float pending_buy_sl       = na
var float pending_buy_M        = na
var string pending_buy_mode    = ""
var int buy_closes_above_M     = 0

// Rilevamento rottura di `m` con IMB in contesto Premium
if is_premium and bear_fvg and not na(ref_m_short) and close < ref_m_short
    pending_sell_imb_top := low[2]
    pending_sell_imb_bot := high
    pending_sell_sl      := ta.highest(high, 8) + (1.0 * pip_val)
    pending_sell_m       := ref_m_short
    pending_sell_mode    := accum_mode
    sell_closes_below_m  := 1
    if is_horiz_box and show_box
        box.new(bar_index - box_len, box_M, bar_index - 1, box_m, bgcolor=color.new(color.gray, 88), border_color=color.gray, border_style=line.style_dotted)
    box.new(bar_index[2], low[2], bar_index + 6, high, bgcolor=color.new(color.purple, 80), border_color=color.purple)
else if not na(pending_sell_m)
    if close < pending_sell_m
        sell_closes_below_m += 1
    else if high >= pending_sell_sl
        pending_sell_m := na
        sell_closes_below_m := 0

// Quando abbiamo >= 2 chiusure sotto `m` e il prezzo RIENTRA nell'IMB -> ENTRY SHORT!
sell_retest_triggered = not na(pending_sell_m) and sell_closes_below_m >= 2 and high >= pending_sell_imb_bot and high < pending_sell_sl

if sell_retest_triggered and show_levels
    entry_p = pending_sell_imb_bot
    tp_mtf  = mtf_range_low
    tp_50   = entry_p - ((entry_p - tp_mtf) * 0.50)

    label.new(bar_index, high, "ENTRY SHORT (" + pending_sell_mode + ")", yloc=yloc.abovebar, color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    line.new(bar_index, entry_p, bar_index + 10, entry_p, color=color.blue, width=2)
    line.new(bar_index, pending_sell_sl, bar_index + 10, pending_sell_sl, color=color.red, width=2)
    line.new(bar_index, tp_mtf, bar_index + 10, tp_mtf, color=color.green, width=2)

    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "entry_type": "' + pending_sell_mode + '", "action": "SELL", "entry_price": ' + str.tostring(entry_p) + ', "sl_price": ' + str.tostring(pending_sell_sl) + ', "tp_50_eq": ' + str.tostring(tp_50) + ', "tp_structural": ' + str.tostring(tp_mtf) + ', "htf_key_level": "MTF_PREMIUM_KL"}', alert.freq_once_per_bar_close)
    pending_sell_m := na
    sell_closes_below_m := 0

// Rilevamento rottura di `M` con IMB in contesto Discount
if is_discount and bull_fvg and not na(ref_M_long) and close > ref_M_long
    pending_buy_imb_top := low
    pending_buy_imb_bot := high[2]
    pending_buy_sl      := ta.lowest(low, 8) - (1.0 * pip_val)
    pending_buy_M       := ref_M_long
    pending_buy_mode    := accum_mode
    buy_closes_above_M  := 1
    if is_horiz_box and show_box
        box.new(bar_index - box_len, box_M, bar_index - 1, box_m, bgcolor=color.new(color.gray, 88), border_color=color.gray, border_style=line.style_dotted)
    box.new(bar_index[2], low, bar_index + 6, high[2], bgcolor=color.new(color.purple, 80), border_color=color.purple)
else if not na(pending_buy_M)
    if close > pending_buy_M
        buy_closes_above_M += 1
    else if low <= pending_buy_sl
        pending_buy_M := na
        buy_closes_above_M := 0

// Quando abbiamo >= 2 chiusure sopra `M` e il prezzo RIENTRA nell'IMB -> ENTRY LONG!
buy_retest_triggered = not na(pending_buy_M) and buy_closes_above_M >= 2 and low <= pending_buy_imb_top and low > pending_buy_sl

if buy_retest_triggered and show_levels
    entry_p = pending_buy_imb_top
    tp_mtf  = mtf_range_high
    tp_50   = entry_p + ((tp_mtf - entry_p) * 0.50)

    label.new(bar_index, low, "ENTRY LONG (" + pending_buy_mode + ")", yloc=yloc.belowbar, color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    line.new(bar_index, entry_p, bar_index + 10, entry_p, color=color.blue, width=2)
    line.new(bar_index, pending_buy_sl, bar_index + 10, pending_buy_sl, color=color.red, width=2)
    line.new(bar_index, tp_mtf, bar_index + 10, tp_mtf, color=color.green, width=2)

    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "entry_type": "' + pending_buy_mode + '", "action": "BUY", "entry_price": ' + str.tostring(entry_p) + ', "sl_price": ' + str.tostring(pending_buy_sl) + ', "tp_50_eq": ' + str.tostring(tp_50) + ', "tp_structural": ' + str.tostring(tp_mtf) + ', "htf_key_level": "MTF_DISCOUNT_KL"}', alert.freq_once_per_bar_close)
    pending_buy_M := na
    buy_closes_above_M := 0
