//@version=5
indicator("Institutional A-M-D & SMT Engine [Clean Pro]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUT SETTINGS & KILLZONES
// ==============================================================================
grp_sess = "Finestre Operative (Killzones)"
show_london   = input.bool(true, "Mostra London Killzone", group=grp_sess)
london_sess   = input.session("0800-1130:23456", "Orario Londra (CET)", group=grp_sess)
col_london    = input.color(color.new(color.blue, 90), "Colore Londra", group=grp_sess)

show_ny       = input.bool(true, "Mostra New York Killzone", group=grp_sess)
ny_sess       = input.session("1300-1630:23456", "Orario New York (CET)", group=grp_sess)
col_ny        = input.color(color.new(color.orange, 90), "Colore New York", group=grp_sess)

grp_range     = "Dealing Range & 50% Equilibrium (Senza Medie Mobili)"
show_range_lines = input.bool(true, "Mostra Range & Equilibrium di Sessione", group=grp_range)
col_eq        = input.color(color.new(color.yellow, 20), "Colore Equilibrium (50%)", group=grp_range)

grp_fvg       = "Fair Value Gaps (Imbalance)"
show_fvg      = input.bool(true, "Disegna FVG", group=grp_fvg)
min_gap_ticks = input.int(10, "Minimo Gap (Tick / Pips)", group=grp_fvg)
show_fvg_text = input.bool(false, "Mostra etichette di testo dentro i box FVG", group=grp_fvg)
col_bull_fvg  = input.color(color.new(color.teal, 85), "Colore Bullish FVG", group=grp_fvg)
col_bear_fvg  = input.color(color.new(color.maroon, 85), "Colore Bearish FVG", group=grp_fvg)

grp_smt       = "SMT Divergence (DXY Benchmark)"
enable_smt    = input.bool(true, "Rileva Divergenze SMT con DXY", group=grp_smt)
dxy_ticker    = input.symbol("TVC:DXY", "Ticker DXY", group=grp_smt)
pivot_bars    = input.int(3, "Forza Pivot Swing (Barre a Sx e Dx)", minval=2, maxval=5, group=grp_smt)

// ==============================================================================
// 2. SESSION TIMING & CLEAN BOXES
// ==============================================================================
in_london = not na(time(timeframe.period, london_sess, "Europe/Rome"))
in_ny     = not na(time(timeframe.period, ny_sess, "Europe/Rome"))

var box l_box = na
var box ny_box = na

// Session High/Low per calcolo Dealing Range reale
var float sess_high = na
var float sess_low = na

if show_london
    if in_london and not in_london[1]
        sess_high := high
        sess_low  := low
        l_box := box.new(left=bar_index, top=high, right=bar_index, bottom=low, 
                         bgcolor=col_london, border_color=color.new(color.blue, 40), 
                         border_style=line.style_dashed, text="London KZ", text_size=size.tiny, text_color=color.blue)
    else if in_london and not na(l_box)
        sess_high := math.max(nz(sess_high, high), high)
        sess_low  := math.min(nz(sess_low, low), low)
        box.set_top(l_box, sess_high)
        box.set_bottom(l_box, sess_low)
        box.set_right(l_box, bar_index)

if show_ny
    if in_ny and not in_ny[1]
        sess_high := high
        sess_low  := low
        ny_box := box.new(left=bar_index, top=high, right=bar_index, bottom=low, 
                          bgcolor=col_ny, border_color=color.new(color.orange, 40), 
                          border_style=line.style_dashed, text="NY KZ", text_size=size.tiny, text_color=color.orange)
    else if in_ny and not na(ny_box)
        sess_high := math.max(nz(sess_high, high), high)
        sess_low  := math.min(nz(sess_low, low), low)
        box.set_top(ny_box, sess_high)
        box.set_bottom(ny_box, sess_low)
        box.set_right(ny_box, bar_index)

// ==============================================================================
// 3. EQUILIBRIUM (50%) COME LIVELLO ORIZZONTALE DI SESSIONE (NO MEDIA MOBILE)
// ==============================================================================
// Invece di plottare una linea mobile continua che segue ogni candela curvandosi come una MA,
// tracciamo linee orizzontali fisse solo durante le sessioni attive.
var line eq_line = na

if show_range_lines and (in_london or in_ny) and not na(sess_high) and not na(sess_low)
    curr_eq = (sess_high + sess_low) / 2.0
    if (in_london and not in_london[1]) or (in_ny and not in_ny[1])
        eq_line := line.new(bar_index, curr_eq, bar_index, curr_eq, color=col_eq, style=line.style_dotted, width=1)
    else if not na(eq_line)
        line.set_xy1(eq_line, line.get_x1(eq_line), curr_eq)
        line.set_xy2(eq_line, bar_index, curr_eq)

// Premium vs Discount rispetto all'Equilibrium di sessione
is_premium  = not na(sess_high) and not na(sess_low) and close > ((sess_high + sess_low) / 2.0)
is_discount = not na(sess_high) and not na(sess_low) and close < ((sess_high + sess_low) / 2.0)

// ==============================================================================
// 4. FAIR VALUE GAPS (PULITI, SENZA SOVRAPPOSIZIONI DI TESTO)
// ==============================================================================
fvg_threshold = min_gap_ticks * syminfo.mintick

is_bull_fvg = show_fvg and (low > high[2] + fvg_threshold)
is_bear_fvg = show_fvg and (high < low[2] - fvg_threshold)

if is_bull_fvg
    box.new(left=bar_index[2], top=low, right=bar_index + 4, bottom=high[2], 
            bgcolor=col_bull_fvg, border_color=color.new(color.teal, 60), 
            text=show_fvg_text ? "FVG" : "", text_size=size.tiny, text_color=color.teal)

if is_bear_fvg
    box.new(left=bar_index[2], top=low[2], right=bar_index + 4, bottom=high, 
            bgcolor=col_bear_fvg, border_color=color.new(color.maroon, 60), 
            text=show_fvg_text ? "FVG" : "", text_size=size.tiny, text_color=color.maroon)

// ==============================================================================
// 5. SMT DIVERGENCE (ANCORATA FISICAMENTE AI PIVOT SWING DELLE CANDELE)
// ==============================================================================
// Richiede dati DXY
[dxy_h, dxy_l] = request.security(dxy_ticker, timeframe.period, [high, low])

// Riconoscimento rigoroso dei soli PIVOT (Swing Points reali), NON di ogni singola candela!
ph = ta.pivothigh(high, pivot_bars, pivot_bars)
pl = ta.pivotlow(low, pivot_bars, pivot_bars)

// Pivot corrispondenti sul DXY
dxy_ph = ta.pivothigh(dxy_h, pivot_bars, pivot_bars)
dxy_pl = ta.pivotlow(dxy_l, pivot_bars, pivot_bars)

// Memoria dell'ultimo pivot
var float last_ph = na
var float last_dxy_pl = na

var float last_pl = na
var float last_dxy_ph = na

var int last_ph_idx = na
var int last_pl_idx = na

// SMT BEARISH: Il nostro asset crea un Higher High (sweep), ma DXY crea un Higher Low (non rompe il minimo)
if not na(ph)
    pivot_bar = bar_index - pivot_bars
    if not na(last_ph) and not na(last_dxy_pl)
        is_asset_hh = ph > last_ph
        is_dxy_hl   = dxy_l[pivot_bars] > last_dxy_pl  // DXY ha fallito il lower low
        
        if is_asset_hh and is_dxy_hl and (in_london or in_ny)
            label.new(pivot_bar, na, "SMT ▼", 
                      yloc=yloc.abovebar, 
                      color=color.red, 
                      textcolor=color.white, 
                      style=label.style_label_down, 
                      size=size.tiny,
                      tooltip="SMT Bearish Divergence: " + syminfo.ticker + " Higher High vs DXY Higher Low")
    last_ph := ph
    last_dxy_pl := dxy_l[pivot_bars]
    last_ph_idx := pivot_bar

// SMT BULLISH: Il nostro asset crea un Lower Low, ma DXY crea un Lower High (non rompe il massimo)
if not na(pl)
    pivot_bar = bar_index - pivot_bars
    if not na(last_pl) and not na(last_dxy_ph)
        is_asset_ll = pl < last_pl
        is_dxy_lh   = dxy_h[pivot_bars] < last_dxy_ph  // DXY ha fallito l'higher high
        
        if is_asset_ll and is_dxy_lh and (in_london or in_ny)
            label.new(pivot_bar, na, "SMT ▲", 
                      yloc=yloc.belowbar, 
                      color=color.green, 
                      textcolor=color.white, 
                      style=label.style_label_up, 
                      size=size.tiny,
                      tooltip="SMT Bullish Divergence: " + syminfo.ticker + " Lower Low vs DXY Lower High")
    last_pl := pl
    last_dxy_ph := dxy_h[pivot_bars]
    last_pl_idx := pivot_bar

// ==============================================================================
// 6. ALERT CONDITIONS CON PAYLOAD JSON PER WEBHOOK
// ==============================================================================
alert_short = (in_london or in_ny) and is_premium and is_bear_fvg
alert_long  = (in_london or in_ny) and is_discount and is_bull_fvg

if alert_short
    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "action": "SELL", "price": ' + str.tostring(close) + ', "sl": ' + str.tostring(high[1]) + ', "session": "' + (in_london ? 'LONDON' : 'NEW_YORK') + '", "zone": "PREMIUM", "reason": "Bearish FVG in Killzone"}', alert.freq_once_per_bar_close)

if alert_long
    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "action": "BUY", "price": ' + str.tostring(close) + ', "sl": ' + str.tostring(low[1]) + ', "session": "' + (in_london ? 'LONDON' : 'NEW_YORK') + '", "zone": "DISCOUNT", "reason": "Bullish FVG in Killzone"}', alert.freq_once_per_bar_close)
