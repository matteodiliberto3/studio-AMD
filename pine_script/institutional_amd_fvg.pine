//@version=5
indicator("Institutional A-M-D Engine [HTF to LTF Contextual]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUT SETTINGS & HTF CONTEXT
// ==============================================================================
grp_htf       = "High Timeframe Key Levels (H4 / Daily)"
show_htf_imb  = input.bool(true, "Mostra Imbalance (FVG) H4", group=grp_htf)
htf_period    = input.timeframe("240", "Timeframe HTF per POI", group=grp_htf)
col_h4_imb_b  = input.color(color.new(color.maroon, 85), "Colore IMB H4 Bearish", group=grp_htf)
col_h4_imb_u  = input.color(color.new(color.teal, 85), "Colore IMB H4 Bullish", group=grp_htf)

grp_ltf       = "Accumulazione LTF (Costruzione Liquidità)"
show_accum    = input.bool(true, "Evidenzia Box Accumulazione LTF", group=grp_ltf)
accum_len     = input.int(10, "Lunghezza Accumulo (Barre)", minval=5, maxval=25, group=grp_ltf)
col_accum     = input.color(color.new(color.gray, 88), "Colore Box Accumulazione", group=grp_ltf)

grp_entries   = "Livelli Operativi Contestuali (SL e Target)"
show_targets  = input.bool(true, "Traccia Stop Loss, TP 50% e TP Strutturale", group=grp_entries)
col_sl        = input.color(color.red, "Colore Stop Loss (Estremo Manipolazione)", group=grp_entries)
col_tp1       = input.color(color.yellow, "Colore Target 1 (50% Parziale)", group=grp_entries)
col_tp_fin    = input.color(color.green, "Colore Target Finale (Liquidità Opposta)", group=grp_entries)

// ==============================================================================
// 2. RECUPERO DATI E IMBALANCE HTF (H4)
// ==============================================================================
[h4_high, h4_low, h4_close, h4_open] = request.security(syminfo.tickerid, htf_period, [high, low, close, open])

// Imbalance H4 (3-bar pattern su H4)
h4_bear_imb = (h4_low[2] - h4_high) > (syminfo.mintick * 20)
h4_bull_imb = (h4_low - h4_high[2]) > (syminfo.mintick * 20)

var box h4_box = na
if show_htf_imb and h4_bear_imb
    h4_box := box.new(left=bar_index - 15, top=h4_low[2], right=bar_index + 10, bottom=h4_high,
                      bgcolor=col_h4_imb_b, border_color=color.new(color.maroon, 40),
                      text="HTF IMB (H4 Bearish)", text_size=size.tiny, text_color=color.white)

if show_htf_imb and h4_bull_imb
    h4_box := box.new(left=bar_index - 15, top=h4_low, right=bar_index + 10, bottom=h4_high[2],
                      bgcolor=col_h4_imb_u, border_color=color.new(color.teal, 40),
                      text="HTF IMB (H4 Bullish)", text_size=size.tiny, text_color=color.white)

// Dealing Range HTF (Massimo e Minimo H4 recenti)
htf_range_high = ta.highest(h4_high, 20)
htf_range_low  = ta.lowest(h4_low, 20)
htf_equilibrium = (htf_range_high + htf_range_low) / 2.0
is_htf_premium  = close > htf_equilibrium
is_htf_discount = close < htf_equilibrium

// ==============================================================================
// 3. ACCUMULAZIONE LTF (Base di Liquidità)
// ==============================================================================
accum_high = ta.highest(high[1], accum_len)
accum_low  = ta.lowest(low[1], accum_len)
accum_range = (accum_high - accum_low)

var box b_accum = na
if show_accum and (accum_range < syminfo.mintick * 120)
    b_accum := box.new(left=bar_index - accum_len, top=accum_high, right=bar_index, bottom=accum_low,
                       bgcolor=col_accum, border_color=color.new(color.gray, 60),
                       border_style=line.style_dotted, text="Accumulo LTF", text_size=size.tiny)

// ==============================================================================
// 4. MANIPOLAZIONE (M) & ROTTURA STRUTTURALE CON IMBALANCE
// ==============================================================================
// Manipolazione Bearish: sweep sopra l'accumulo in zona Premium
is_manip_bear = is_htf_premium and (high > accum_high) and (close < high)
// Manipolazione Bullish: sweep sotto l'accumulo in zona Discount
is_manip_bull = is_htf_discount and (low < accum_low) and (close > low)

var float last_manip_high = na
var float last_manip_low  = na

if is_manip_bear
    last_manip_high := high
    label.new(bar_index, high, "MANIPOLAZIONE (M)", yloc=yloc.abovebar,
              color=color.purple, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if is_manip_bull
    last_manip_low := low
    label.new(bar_index, low, "MANIPOLAZIONE (M)", yloc=yloc.belowbar,
              color=color.purple, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// Imbalance di rottura LTF (Displacement)
ltf_fvg_bear = (low[2] - high) > (syminfo.mintick * 12)
ltf_fvg_bull = (low - high[2]) > (syminfo.mintick * 12)

is_breakout_retest_sell = is_htf_premium and (close < accum_low) and ltf_fvg_bear and not na(last_manip_high)
is_breakout_retest_buy  = is_htf_discount and (close > accum_high) and ltf_fvg_bull and not na(last_manip_low)

// ==============================================================================
// 5. TRACCIAMENTO DEI LIVELLI OPERATIVI (NO R:R FISSO)
// ==============================================================================
if show_targets and is_breakout_retest_sell
    entry_p = accum_low
    sl_p    = last_manip_high + (syminfo.mintick * 15)
    tp1_p   = entry_p - ((entry_p - htf_range_low) * 0.50)
    tp2_p   = htf_range_low

    box.new(left=bar_index[2], top=low[2], right=bar_index + 6, bottom=high,
            bgcolor=color.new(color.purple, 80), border_color=color.purple, text="IMB Rottura", text_size=size.tiny)

    line.new(bar_index, entry_p, bar_index + 15, entry_p, color=color.blue, width=2, style=line.style_solid)
    line.new(bar_index, sl_p, bar_index + 15, sl_p, color=col_sl, width=2, style=line.style_solid)
    line.new(bar_index, tp1_p, bar_index + 15, tp1_p, color=col_tp1, width=1, style=line.style_dashed)
    line.new(bar_index, tp2_p, bar_index + 15, tp2_p, color=col_tp_fin, width=2, style=line.style_solid)

    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "entry_type": "BREAKOUT_RETEST", "action": "SELL", "entry_price": ' + str.tostring(entry_p) + ', "sl_price": ' + str.tostring(sl_p) + ', "tp_50_eq": ' + str.tostring(tp1_p) + ', "tp_structural": ' + str.tostring(tp2_p) + ', "htf_key_level": "H4_PREMIUM_IMB"}', alert.freq_once_per_bar_close)

if show_targets and is_breakout_retest_buy
    entry_p = accum_high
    sl_p    = last_manip_low - (syminfo.mintick * 15)
    tp1_p   = entry_p + ((htf_range_high - entry_p) * 0.50)
    tp2_p   = htf_range_high

    box.new(left=bar_index[2], top=low, right=bar_index + 6, bottom=high[2],
            bgcolor=color.new(color.purple, 80), border_color=color.purple, text="IMB Rottura", text_size=size.tiny)

    line.new(bar_index, entry_p, bar_index + 15, entry_p, color=color.blue, width=2, style=line.style_solid)
    line.new(bar_index, sl_p, bar_index + 15, sl_p, color=col_sl, width=2, style=line.style_solid)
    line.new(bar_index, tp1_p, bar_index + 15, tp1_p, color=col_tp1, width=1, style=line.style_dashed)
    line.new(bar_index, tp2_p, bar_index + 15, tp2_p, color=col_tp_fin, width=2, style=line.style_solid)

    alert('{"symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "entry_type": "BREAKOUT_RETEST", "action": "BUY", "entry_price": ' + str.tostring(entry_p) + ', "sl_price": ' + str.tostring(sl_p) + ', "tp_50_eq": ' + str.tostring(tp1_p) + ', "tp_structural": ' + str.tostring(tp2_p) + ', "htf_key_level": "H4_DISCOUNT_IMB"}', alert.freq_once_per_bar_close)
